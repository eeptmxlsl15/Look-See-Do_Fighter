{
  "description": "LSDF session-start context only. Validation runs once at task completion; see Hook.md.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import runpy,subprocess,sys; root=subprocess.check_output(['git','rev-parse','--show-toplevel'],text=True).strip(); sys.argv=[root+'/tools/ai/quantum_guard.py','hook']; runpy.run_path(sys.argv[0],run_name='__main__')\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
